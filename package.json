{
  "name": "openhab_rules_tools",
  "version": "2.2.0",
  "description": "Functions and classes to make writing openHAB rules in JS Scripting easier.",
  "private": false,
  "license": "EPL-2.0",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rkoshak/openhab-rules-tools.git#main"
  },
  "scripts": {
    "test": "jest",
    "docs": "jsdoc countdownTimer.js deferred.js gatekeeper.js groupUtils.js helpers.js index.js loopingTimer.js rateLimit.js rulesUtils.js timerMgr.js timeUtils.js README.md -d docs"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/tests/mockOpenHAB.js"
    ],
    "testMatch": [
      "**/tests/unit/**/*.test.js"
    ],
    "moduleNameMapper": {
      "^openhab_rules_tools$": "<rootDir>/index.js"
    }
  },
  "keywords": [
    "openHAB",
    "JSScripting"
  ],
  "author": "Richard Koshak",
  "bugs": {
    "url": "https://github.com/rkoshak/openhab-rules-tools/issues"
  },
  "devDependencies": {
    "@js-joda/core": "^6.1.0",
    "jest": "^30.4.2",
    "jsdoc": "^4.0.5",
    "openhab": "^5.21.0"
  }
}
